{
  "manifest": {
    "manifestVersion": "1.0",
    "apis": {
      "custom": {
        "endpoint": {
          "uri": "https://microtroniks.com/alexa"
        },
        "interfaces": []
      }
    },
    "permissions": [
      {
        "name": "alexa::devices:all:notifications:write"
      }
    ],
    "events": {
      "endpoint": {
        "uri": "https://microtroniks.com/alexa",
        "sslCertificateType": "Trusted"
      },
      "publications": [
        {
          "eventName": "AMAZON.OrderStatus.Updated"
        }
      ],
      "subscriptions": [
        {
          "eventName": "SKILL_PROACTIVE_SUBSCRIPTION_CHANGED"
        }
      ]
    },
    "publishingInformation": {
      "isAvailableWorldwide": true,
      "distributionCountries": [],
      "automaticClonedLocale": {
        "locales": [
          {
            "source": "en-US"
          }
        ]
      },
      "locales": {
        "en-US": {
          "name": "Notiffi Alert",
          "summary": "Smart delivery tracking for residents.",
          "description": "Receive package and locker alerts with Notiffi Alert.",
          "examplePhrases": [
            "Alexa, open Notiffi Alert",
            "Alexa, ask Notiffi Alert for my packages",
            "Alexa, ask Notiffi Alert for mailroom hours"
          ],
          "keywords": [
            "packages",
            "delivery",
            "mailroom"
          ]
        }
      },
      "testingInstructions": "Open the skill, enable notifications in Alexa App, then POST a webhook to /webhook/package-delivered."
    }
  }
}