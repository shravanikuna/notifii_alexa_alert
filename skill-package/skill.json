{
  "manifest": {
    "manifestVersion": "1.0",
    "apis": {
      "custom": {
        "endpoint": {
          "uri": "https://microtroniks.com/alexa"
        },
        "interfaces": []
      }
    },
    "permissions": [
      {
        "name": "alexa::devices:all:notifications:write"
      }
    ],
    "events": {
      "endpoint": {
        "uri": "https://microtroniks.com/alexa",
        "sslCertificateType": "Trusted"
      },
      "publications": [
        {
          "eventName": "AMAZON.OrderStatus.Updated"
        }
      ],
      "subscriptions": [
        {
          "eventName": "SKILL_PROACTIVE_SUBSCRIPTION_CHANGED"
        }
      ]
    },
    "publishingInformation": {
      "isAvailableWorldwide": true,
      "distributionCountries": [],
      "automaticClonedLocale": {
        "locales": [
          {
            "source": "en-US"
          }
        ]
      },
      "locales": {
        "en-US": {
          "name": "rabbit",
          "summary": "Smart delivery tracking for residents.",
          "description": "Receive package alerts with Rabbit.",
          "examplePhrases": [
            "Alexa, open rabbit",
            "Alexa, ask rabbit for my packages"
          ],
          "keywords": [
            "packages"
          ]
        },
        "en-IN": {
          "name": "rabbit",
          "summary": "Smart delivery tracking for residents.",
          "description": "Receive package alerts with Rabbit.",
          "examplePhrases": [
            "Alexa, open rabbit",
            "Alexa, ask rabbit for my packages"
          ],
          "keywords": [
            "packages"
          ]
        },
        "en-GB":{
          "name": "rabbit",
          "summary":"Smart delivery tracking for residents.",
          "description":"Receive package alerts with Rabbit",
          "examplePhrases": [
            "Alexa, open rabbit",
          "Alexa, ask rabbit for my packages"
          ],
          "keywords":[
